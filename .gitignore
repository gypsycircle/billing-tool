# GypsyCircle billing tool — what stays OUT of the repository.
# Committed: app/, components/, hooks/, lib/, private-templates/ (the bill's
# fonts, logo and QR code, which the server needs), tests/ (Vitest stubs),
# README.md, and the config files at the root.

# ── Dependencies ───────────────────────────────────────────────────────────
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# ── Build output and generated files ──────────────────────────────────────
/.next/
/out/
/build
/coverage
*.tsbuildinfo
next-env.d.ts

# ── Environment files: every one of them, .env.example included ───────────
# Production values live in Vercel's environment variables, never in Git.
.env*

# ── Secrets and keys ──────────────────────────────────────────────────────
*.pem
*.key
*.json.key
*.p12

# ── Local-only folders ─────────────────────────────────────────────────────
# docs/: the Google service-account key, sample bills with customer data, plans
/docs/
# scripts/: security and e2e test suites, PDF asset tools and their Python venv
/scripts/
# Variable-font sources, only read by the local scripts/pdf/build_assets.py
/private-templates/fonts/src/

# ── AI-assistant notes and editor settings ────────────────────────────────
CLAUDE.md
AGENTS.md
/.claude/
.vscode/
.idea/
*.swp

# ── Vercel ─────────────────────────────────────────────────────────────────
.vercel

# ── OS files ───────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db

# ── Logs and caches ───────────────────────────────────────────────────────
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
__pycache__/
.eslintcache
